<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <!-- CameraX Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Anti-Covert Surveillance: Prominent Live Streaming Banner -->
    <LinearLayout
        android:id="@+id/liveBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D9EF4444"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 LIVE CAMERA STREAMING TO ANDROSCRN DESKTOP"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Top Connection & Port Info Header -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#B30F172A"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/liveBanner">

        <View
            android:id="@+id/connectionIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@color/emerald_green"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/txtConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Companion Server: 127.0.0.1:8080"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Pairing PIN Challenge Card Overlay -->
    <androidx.cardview.widget.CardView
        android:id="@+id/pairingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F20F172A"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 Desktop Pairing Request"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enter this 6-digit verification PIN on your PC to authorize camera control:"
                android:textAlignment="center"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtPairingPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:text="849 201"
                android:letterSpacing="0.2"
                android:textColor="@color/emerald_green"
                android:textStyle="bold"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/txtPairingExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expires in 60s"
                android:textColor="#F59E0B"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Controls & Camera State -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D9090D16"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="3">

            <TextView
                android:id="@+id/txtCameraFacing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lens: Back Main"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtZoomRatio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zoom: 1.0x"
                android:textAlignment="center"
                android:textColor="#38BDF8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtTorchState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Torch: Off"
                android:textAlignment="viewEnd"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnFlipCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Flip Lens"
                android:backgroundTint="#334155"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnToggleTorch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Torch"
                android:backgroundTint="#334155"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnLocalSnapshot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 Photo"
                android:backgroundTint="@color/accent_blue"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Permission Request Overlay -->
    <LinearLayout
        android:id="@+id/permissionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 Camera Permission Required"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/camera_permission_required"
            android:textAlignment="center"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/grant_permission"
            android:backgroundTint="@color/accent_blue"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
