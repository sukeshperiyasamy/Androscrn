{
  "name": "androscrn",
  "version": "1.0.0-alpha.1",
  "description": "Next-Generation Android Control & Automation Platform for Windows",
  "main": "apps/desktop/dist-electron/main.js",
  "scripts": {
    "test:unit": "tsc -p tsconfig.json && node dist/tests/unit/runner.js",
    "test:integration": "tsc -p tsconfig.json && node dist/tests/integration/integration.test.js",
    "test": "tsc -p tsconfig.json && node dist/tests/unit/runner.js && node dist/tests/integration/integration.test.js",
    "build:modules": "tsc -p tsconfig.json",
    "dev:desktop": "cd apps/desktop && npm run dev",
    "build": "npm run build:modules && cd apps/desktop && npm run build && tsc -p tsconfig.electron.json",
    "build:portable": "powershell -ExecutionPolicy Bypass -File packaging/portable/package-portable.ps1"
  },
  "keywords": [
    "android",
    "scrcpy",
    "adb",
    "screen-mirroring",
    "automation",
    "desktop",
    "windows"
  ],
  "author": "AndroScrn Contributors",
  "license": "MIT"
}
