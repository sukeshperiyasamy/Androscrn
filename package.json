{
  "name": "androscrn",
  "version": "1.0.0-alpha.1",
  "description": "Next-Generation Android Control & Automation Platform for Windows",
  "homepage": "https://sukeshperiyasamy.github.io/Androscrn",
  "main": "apps/desktop/dist-electron/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix apps/desktop exec tsc -- --noEmit -p tsconfig.json",
    "test:unit": "tsc -p tsconfig.json && node dist/tests/unit/runner.js",
    "test:native-cli": "tsc -p tsconfig.json && node dist/tests/unit/targeted.js native",
    "test:path": "tsc -p tsconfig.json && node dist/tests/unit/targeted.js path",
    "test:document": "tsc -p tsconfig.json && node dist/tests/unit/targeted.js document",
    "docs:check": "node scripts/check-docs.js",
    "test:styling": "tsc -p tsconfig.json && node dist/tests/unit/targeted.js styling",
    "validate:ocr": "tsc -p tsconfig.json && node dist/tests/validation/ocr-validation.js",
    "validate:ocr:real": "tsc -p tsconfig.json && node dist/tests/validation/real-photo-validation.js",
    "validate:pdf": "tsc -p tsconfig.json && node dist/tests/validation/pdf-validation.js",
    "test:discovery": "tsc -p tsconfig.json && node dist/tests/unit/targeted.js discovery",
    "test:integration": "tsc -p tsconfig.json && node dist/tests/integration/integration.test.js",
    "test:ui": "tsc -p tsconfig.json && node dist/tests/ui/playwright-ui.test.js",
    "test:hardware": "tsc -p tsconfig.json && node dist/tests/hardware/hardware-validation.js",
    "test": "tsc -p tsconfig.json && node dist/tests/unit/runner.js && node dist/tests/integration/integration.test.js && node dist/tests/ui/playwright-ui.test.js",
    "build:modules": "tsc -p tsconfig.json",
    "dev:desktop": "cd apps/desktop && npm run dev",
    "build": "npm run build:modules && npm --prefix apps/desktop run build",
    "build:companion": "node scripts/build-companion.js",
    "build:portable": "powershell -ExecutionPolicy Bypass -File packaging/portable/package-portable.ps1",
    "cli": "node dist/modules/cli/index.js"
  },
  "keywords": [
    "android",
    "scrcpy",
    "adb",
    "screen-mirroring",
    "automation",
    "desktop",
    "windows"
  ],
  "author": "AndroScrn Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pngjs": "^6.0.5",
    "pdfjs-dist": "^4.10.38",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  }
}
